# Sector Seven Cyber LLC - Environment Configuration Example

# Supabase Database & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Transactional Email Provider (Resend / Postmark)
RESEND_API_KEY=your_resend_api_key_here
INTERNAL_NOTIFICATION_EMAIL=contact@sectorsevencyber.com
FROM_EMAIL=contact@sectorsevencyber.com

# Site Domain & Legal Versioning
NEXT_PUBLIC_SITE_URL=https://sectorsevencyber.com
LEGAL_TERMS_VERSION=2026-09-01

# Stripe Payment Gateway (Subscription & Checkout)
# Developers > API keys:
STRIPE_SECRET_KEY=sk_test_51...your_secret_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51...your_publishable_key_here
# Developers > Webhooks (endpoint: https://sectorsevencyber.com/api/stripe-webhook):
STRIPE_WEBHOOK_SECRET=whsec_...your_webhook_signing_secret_here
